{
    "version": 2,
    "experimentalServices": {
        "frontend": {
            "entrypoint": "frontend",
            "routePrefix": "/",
            "framework": "vite"
        },
        "backend": {
            "entrypoint": "backend",
            "routePrefix": "/_/backend"
        }
    },
    "routes": [
        { "src": "/api/(.*)", "dest": "/_/backend/api/$1" }
    ]
}
